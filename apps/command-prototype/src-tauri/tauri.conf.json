{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git-K Prototype",
  "version": "0.1.0",
  "identifier": "dev.git-k.execution-prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Git-K — execution prototype", "width": 1400, "height": 850, "minWidth": 1000, "minHeight": 680, "backgroundColor": "#11151d" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/icon.ico"] }
}
